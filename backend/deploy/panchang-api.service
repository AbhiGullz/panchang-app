[Unit]
Description=Panchang FastAPI service
After=network.target redis.service

[Service]
Type=simple
WorkingDirectory=/home/abhishek/Software Pipeline/PanchangApp/backend
ExecStart=/home/abhishek/Software Pipeline/PanchangApp/backend/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
